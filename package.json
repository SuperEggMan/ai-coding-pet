{
  "name": "ai-coding-pet",
  "version": "0.1.0",
  "private": true,
  "description": "One pet per AI coding session. Layered-SVG pets with interpolated state transitions, imperial-edict skin, blocking permission approval.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "AICP_DEMO=1 electron .",
    "dev": "AICP_DEBUG=1 electron .",
    "poses": "AICP_POSES=1 electron .",
    "probe": "node scripts/probe.js",
    "smoke": "node scripts/smoke-agent.js",
    "frames:placeholder": "node scripts/make-placeholder-frames.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "pitch": "AICP_DEMO=1 AICP_PITCH=1 electron ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.sofaware.aicodingpet",
    "productName": "AI Coding Pet",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "mobile/**/*",
      "scripts/**/*",
      "docs/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
